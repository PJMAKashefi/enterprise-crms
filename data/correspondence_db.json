      "defaultSalutation": "Dear Ms.",
      "subjectFormat": "{subject} - {letterNumber}",
      "bodyFormat": "Dear {salutation} {recipientName},\n\nKindly please find the attached file regarding \"{subject}\" (Official Ref: {letterNumber}), including the relevant Proforma Invoice and commercial documentation.\n\nPlease arrange for the necessary commercial clearance and advance payment issuance according to the agreed milestone schedule.\n\nShould your finance or procurement team require any clarifications, please feel free to reach out.\n\nYours sincerely,\n{signatoryName}\n{signatoryPosition}\n{companyName}",
      "isSystem": true
